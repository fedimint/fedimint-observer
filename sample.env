FO_BIND="127.0.0.1:3000"
# `/` in the socket path for host is a reserved character, so we need to either
# provide as a query param (`?host=`) or percent-encode (`%2F`)
FO_DATABASE="postgres://${PGUSER}@/${PGDATABASE}?host=${PGHOST}&port=${PGPORT}"
FO_ADMIN_AUTH="foobar"
FO_MEMPOOL_URL="https://mempool.space/api"

# Bearer token LN probers use to submit gateway probe results. Probe ingestion
# is disabled if unset.
FO_PROBER_AUTH="prober-secret"

# fmo_prober configuration (see fmo_prober/README.md)
# FMP_OBSERVER_URL="http://127.0.0.1:3000"
# FMP_OBSERVER_AUTH="prober-secret"
# FMP_PROBER_ID="local-dev"
# FMP_LND_REST_URL="https://127.0.0.1:8080"
# FMP_LND_MACAROON="$HOME/.lnd/data/chain/bitcoin/mainnet/admin.macaroon"
# FMP_LND_TLS_CERT="$HOME/.lnd/tls.cert"
# FMP_PROBE_INTERVAL_SECS=1800
# FMP_PROBE_AMOUNTS_SAT="10000,100000,1000000"
# FMP_MAX_FEE_SAT=1000
# FMP_PROBE_TIMEOUT_SECS=60
# FMP_NODE_ALLOWLIST=""
